# AWS Configuration
# Copy this file to .env.local and fill in your values

# ============================================
# FOR LOCAL DEVELOPMENT (npm run dev)
# ============================================
# These are used server-side by Next.js API routes
AWS_REGION=us-east-1
AGENTCORE_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-agent-runtime-id

# Cognito login (frontend auth). Create a user pool with admin-only signup
# and an app client (no secret) with USER_PASSWORD_AUTH enabled.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=your-app-client-id
COGNITO_REGION=us-east-1
